{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusk",
  "version": "0.1.0",
  "identifier": "app.dusk.tray",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Raaj",
    "license": "MIT",
    "shortDescription": "Night Light and HDR brightness sliders in the system tray",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  }
}
